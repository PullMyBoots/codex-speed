diff --git a/codex-rs/core/src/stream_throughput.rs b/codex-rs/core/src/stream_throughput.rs
new file mode 100644
index 000000000..7c886eca1
--- /dev/null
+++ b/codex-rs/core/src/stream_throughput.rs
@@ -0,0 +1,376 @@
+//! Client-observed output throughput, isolated to one upstream sampling request.
+//!
+//! Text, tool-input and raw reasoning deltas contribute to observed decode.
+//! Summaries have a separate clock and never stand in for hidden reasoning.
+//! Each item/channel starts a new interval, excluding TTFT, tools and idle time.
+//! The first chunk is a baseline, not tokens generated during a zero-length interval.
+//! o200k BPE is a live estimate; at completion, non-reasoning server usage calibrates
+//! that estimate. Transport buffering and tokenizer differences remain observable
+//! limitations, so the UI always labels the rate as approximate.
+
+use codex_protocol::protocol::ModelStreamMetrics;
+use std::collections::VecDeque;
+use std::sync::LazyLock;
+use std::time::Duration;
+use std::time::Instant;
+
+const INTERVAL: Duration = Duration::from_millis(100);
+const WINDOW: Duration = Duration::from_secs(1);
+static TOKENIZER: LazyLock<Option<tiktoken_rs::CoreBPE>> =
+    LazyLock::new(|| tiktoken_rs::o200k_base().ok());
+
+#[derive(Default)]
+pub(crate) struct StreamThroughput {
+    text: String,
+    first: Option<Instant>,
+    last: Option<Instant>,
+    first_tokens: usize,
+    samples: VecDeque<(Instant, usize)>,
+    emitted_at: Option<Instant>,
+    total_tokens: usize,
+    timed_tokens: usize,
+    duration: Duration,
+}
+
+impl StreamThroughput {
+    pub(crate) fn new() -> Self {
+        // Load before the request, so tokenizer initialization is never timed.
+        LazyLock::force(&TOKENIZER);
+        Self::default()
+    }
+
+    fn count(text: &str) -> usize {
+        TOKENIZER
+            .as_ref()
+            .map_or(0, |bpe| bpe.encode_ordinary(text).len())
+    }
+
+    pub(crate) fn push(&mut self, delta: &str, now: Instant) -> Option<ModelStreamMetrics> {
+        if delta.is_empty() {
+            return None;
+        }
+        self.text.push_str(delta);
+        self.last = Some(now);
+        if self.first.is_none() {
+            self.first = Some(now);
+            self.first_tokens = Self::count(&self.text);
+            self.samples.push_back((now, self.first_tokens));
+        }
+        if self
+            .emitted_at
+            .is_some_and(|last| now.duration_since(last) < INTERVAL)
+        {
+            return None;
+        }
+        self.emitted_at = Some(now);
+        let tokens = Self::count(&self.text);
+        self.samples.push_back((now, tokens));
+        // Retain the sample just before the cutoff, avoiding a shortened window.
+        while self.samples.len() > 2 && now.duration_since(self.samples[1].0) >= WINDOW {
+            self.samples.pop_front();
+        }
+        let (start, baseline) = *self.samples.front()?;
+        let elapsed = now.duration_since(start);
+        let mut metrics = self.snapshot("streaming");
+        metrics.output_tps = rate(tokens.saturating_sub(baseline), elapsed);
+        Some(metrics)
+    }
+
+    pub(crate) fn end_item(&mut self) {
+        let tokens = Self::count(&self.text);
+        self.total_tokens += tokens;
+        if let (Some(first), Some(last)) = (self.first, self.last) {
+            self.timed_tokens += tokens.saturating_sub(self.first_tokens);
+            self.duration += last.duration_since(first);
+        }
+        self.text.clear();
+        self.first = None;
+        self.last = None;
+        self.samples.clear();
+        self.emitted_at = None;
+    }
+
+    pub(crate) fn snapshot(&self, phase: &str) -> ModelStreamMetrics {
+        let current_tokens = Self::count(&self.text);
+        let current_duration = self
+            .first
+            .zip(self.last)
+            .map_or(Duration::ZERO, |(first, last)| last.duration_since(first));
+        ModelStreamMetrics {
+            phase: phase.to_owned(),
+            stream_kind: "text".to_owned(),
+            output_tps: None,
+            average_tps: rate(
+                self.timed_tokens + current_tokens.saturating_sub(self.first_tokens),
+                self.duration + current_duration,
+            ),
+            estimated: true,
+            window_ms: WINDOW.as_millis() as u64,
+            sample_interval_ms: INTERVAL.as_millis() as u64,
+            generation_ms: (self.duration + current_duration).as_millis() as u64,
+            streamed_tokens: (self.total_tokens + current_tokens) as u64,
+            reported_output_tokens: None,
+            reported_reasoning_tokens: None,
+        }
+    }
+
+    pub(crate) fn finish(
+        &mut self,
+        phase: &str,
+        reported: Option<(i64, i64)>,
+    ) -> ModelStreamMetrics {
+        self.end_item();
+        let mut metrics = self.snapshot(phase);
+        if let Some((output, reasoning)) = reported {
+            metrics.reported_output_tokens = Some(output);
+            metrics.reported_reasoning_tokens = Some(reasoning);
+            if self.total_tokens > 0 && output >= reasoning && reasoning >= 0 {
+                // Match the numerator to the measured visible intervals. Never
+                // divide hidden reasoning tokens by visible-only output time.
+                let scale = (output - reasoning) as f64 / self.total_tokens as f64;
+                metrics.average_tps = metrics.average_tps.map(|rate| rate * scale);
+            }
+        }
+        metrics.output_tps = metrics.average_tps;
+        metrics
+    }
+}
+
+/// A single observed decode clock across text, tools and raw reasoning.
+/// Summaries are timed separately: they may be buffered or produced by another
+/// process and cannot be calibrated with hidden reasoning usage.
+pub(crate) struct DecodeThroughput {
+    decode: StreamThroughput,
+    summary: StreamThroughput,
+    active: Option<String>,
+    saw_raw_reasoning: bool,
+}
+
+impl DecodeThroughput {
+    pub(crate) fn new() -> Self {
+        Self {
+            decode: StreamThroughput::new(),
+            summary: StreamThroughput::new(),
+            active: None,
+            saw_raw_reasoning: false,
+        }
+    }
+
+    pub(crate) fn push(
+        &mut self,
+        kind: &str,
+        delta: &str,
+        now: Instant,
+    ) -> Option<ModelStreamMetrics> {
+        if delta.is_empty() {
+            return None;
+        }
+        if self.active.as_deref() != Some(kind) {
+            self.end_item();
+            self.active = Some(kind.to_owned());
+        }
+        self.saw_raw_reasoning |= kind == "reasoning";
+        let tracker = if kind == "summary" {
+            &mut self.summary
+        } else {
+            &mut self.decode
+        };
+        tracker.push(delta, now).map(|mut metrics| {
+            metrics.stream_kind = kind.to_owned();
+            metrics
+        })
+    }
+
+    pub(crate) fn end_item(&mut self) {
+        self.decode.end_item();
+        self.summary.end_item();
+        self.active = None;
+    }
+
+    pub(crate) fn snapshot(&self, phase: &str) -> ModelStreamMetrics {
+        let mut metrics = self.decode.snapshot(phase);
+        metrics.stream_kind = "mixed".to_owned();
+        metrics
+    }
+
+    pub(crate) fn finish(
+        &mut self,
+        phase: &str,
+        reported: Option<(i64, i64)>,
+    ) -> ModelStreamMetrics {
+        // Raw streams from third-party providers can be partial. Do not inflate
+        // their speed using a total that may include unobserved reasoning.
+        let calibrated = if self.saw_raw_reasoning {
+            None
+        } else {
+            reported
+        };
+        let mut metrics = self.decode.finish(phase, calibrated);
+        metrics.stream_kind = "mixed".to_owned();
+        if metrics.output_tps.is_none() {
+            let mut summary = self.summary.finish(phase, None);
+            if summary.output_tps.is_some() {
+                summary.stream_kind = "summary".to_owned();
+                metrics = summary;
+            }
+        }
+        if let Some((output, reasoning)) = reported {
+            metrics.reported_output_tokens = Some(output);
+            metrics.reported_reasoning_tokens = Some(reasoning);
+        }
+        metrics
+    }
+}
+
+fn rate(tokens: usize, duration: Duration) -> Option<f64> {
+    (duration >= INTERVAL).then(|| tokens as f64 / duration.as_secs_f64())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn waiting_tail_and_between_items_do_not_change_speed() {
+        let now = Instant::now();
+        let mut a = StreamThroughput::new();
+        let mut b = StreamThroughput::new();
+        for tracker in [&mut a, &mut b] {
+            tracker.push("hello", now + Duration::from_secs(30));
+            tracker.push(" world", now + Duration::from_millis(30500));
+            tracker.end_item();
+        }
+        a.push("good", now + Duration::from_secs(31));
+        a.push(" bye", now + Duration::from_millis(31500));
+        b.push("good", now + Duration::from_secs(100));
+        b.push(" bye", now + Duration::from_millis(100500));
+        let a = a.finish("complete", Some((40, 20)));
+        let b = b.finish("complete", Some((40, 20)));
+        assert_eq!(a.generation_ms, 1000);
+        assert_eq!(a.output_tps, b.output_tps);
+    }
+
+    #[test]
+    fn first_chunk_and_single_buffered_chunk_are_not_infinite_speed() {
+        let mut tracker = StreamThroughput::new();
+        let now = Instant::now();
+        assert_eq!(
+            tracker
+                .push("many tokens in one chunk", now)
+                .unwrap()
+                .output_tps,
+            None
+        );
+        assert_eq!(tracker.finish("complete", Some((99, 0))).output_tps, None);
+    }
+
+    #[test]
+    fn stream_count_is_independent_of_chunk_boundaries_and_reasoning_is_excluded() {
+        let now = Instant::now();
+        let text = "你好 hello world 我们测试 streaming tokens.";
+        let mut tracker = StreamThroughput::new();
+        for (i, ch) in text.chars().enumerate() {
+            tracker.push(&ch.to_string(), now + Duration::from_millis(i as u64 * 100));
+        }
+        let metrics = tracker.finish("complete", Some((110, 100)));
+        assert_eq!(
+            metrics.streamed_tokens as usize,
+            StreamThroughput::count(text)
+        );
+        assert!(metrics.output_tps.unwrap() < 10.0);
+    }
+
+    #[test]
+    fn new_request_has_no_previous_window_or_counters() {
+        let now = Instant::now();
+        let mut first = StreamThroughput::new();
+        first.push("hello", now);
+        first.push(" world", now + Duration::from_millis(500));
+        assert!(first.finish("interrupted", None).output_tps.is_some());
+        let mut second = StreamThroughput::new();
+        let metrics = second.push("new", now + Duration::from_secs(60)).unwrap();
+        assert_eq!(metrics.output_tps, None);
+        assert_eq!(metrics.generation_ms, 0);
+    }
+
+    #[test]
+    fn hundred_ms_sampling_and_one_second_window_match_known_throughput() {
+        let now = Instant::now();
+        let mut tracker = StreamThroughput::new();
+        tracker.push(" x", now);
+        assert!(tracker.push("", now + Duration::from_millis(50)).is_none());
+        for i in 1..=30 {
+            let sample = tracker
+                .push(" x", now + Duration::from_millis(i * 100))
+                .unwrap();
+            assert!((sample.output_tps.unwrap() - 10.0).abs() < 1e-6);
+        }
+        let finished = tracker.finish("complete", Some((310, 0)));
+        assert!((finished.output_tps.unwrap() - 100.0).abs() < 1e-6);
+        assert_eq!(finished.generation_ms, 3000);
+    }
+}
+
+#[cfg(test)]
+mod decode_tests {
+    use super::*;
+
+    #[test]
+    fn reasoning_tools_and_text_share_decode_but_exclude_phase_gaps() {
+        let mut tracker = DecodeThroughput::new();
+        let now = Instant::now();
+        for (kind, offset) in [("reasoning", 0), ("tool", 30), ("text", 60)] {
+            for i in 0..=10 {
+                let m = tracker
+                    .push(
+                        kind,
+                        " x",
+                        now + Duration::from_millis(offset * 1000 + i * 100),
+                    )
+                    .unwrap();
+                assert_eq!(m.stream_kind, kind);
+                if i > 0 {
+                    assert!((m.output_tps.unwrap() - 10.0).abs() < 1e-6);
+                }
+            }
+            tracker.end_item();
+        }
+        let done = tracker.finish("complete", Some((9999, 9000)));
+        assert_eq!(done.generation_ms, 3000);
+        assert!((done.output_tps.unwrap() - 10.0).abs() < 1e-6);
+        assert_eq!(done.streamed_tokens, 33);
+    }
+
+    #[test]
+    fn summary_does_not_enter_decode_or_hidden_usage_calibration() {
+        let now = Instant::now();
+        let mut tracker = DecodeThroughput::new();
+        for i in 0..=10 {
+            tracker.push("summary", " x", now + Duration::from_millis(i * 100));
+        }
+        tracker.end_item();
+        for i in 0..=10 {
+            tracker.push(
+                "text",
+                " x",
+                now + Duration::from_secs(30) + Duration::from_millis(i * 100),
+            );
+        }
+        let done = tracker.finish("complete", Some((1011, 1000)));
+        assert_eq!(done.generation_ms, 1000);
+        assert_eq!(done.streamed_tokens, 11);
+        assert!((done.output_tps.unwrap() - 10.0).abs() < 1e-6);
+        assert_eq!(done.stream_kind, "mixed");
+    }
+
+    #[test]
+    fn summary_only_keeps_its_own_rate_even_with_large_hidden_usage() {
+        let now = Instant::now();
+        let mut tracker = DecodeThroughput::new();
+        tracker.push("summary", " x", now);
+        tracker.push("summary", " x", now + Duration::from_millis(100));
+        let done = tracker.finish("complete", Some((5001, 5000)));
+        assert_eq!(done.stream_kind, "summary");
+        assert!((done.output_tps.unwrap() - 10.0).abs() < 1e-6);
+    }
+}
