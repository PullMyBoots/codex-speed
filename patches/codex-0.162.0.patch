+#[test]
+fn cxstatusline_rows_preserve_transcript_cursor_and_shortcut_help() {
+    let mut composer = composer();
+    composer.set_cxstatusline_block(vec![
+        "CX row one".into(),
+        "CX row two".into(),
+        "CX row three".into(),
+    ]);
+    let footer = TranscriptFooter {
+        text: "transcript input".into(),
+        cursor_column: Some(3),
+        is_interactive: true,
+    };
+    for mode in [FooterMode::ComposerEmpty, FooterMode::ShortcutOverlay] {
+        composer.footer.mode = mode;
+        for transcript in [None, Some(&footer)] {
+            let options = composer.resolve_render_options(ComposerRenderOptions {
+                footer: transcript,
+                ..Default::default()
+            });
+            let area = Rect::new(
+                0,
+                0,
+                100,
+                composer.desired_height_with_options(100, options),
+            );
+            let mut buffer = Buffer::empty(area);
+            composer.render_with_options(area, &mut buffer, None, options);
+            let screen = text(&buffer);
+            for row in ["CX row one", "CX row two", "CX row three"] {
+                assert!(screen.contains(row), "missing {row}: {screen}");
+            }
+            if transcript.is_some() {
+                let row = screen
+                    .lines()
+                    .position(|line| line.contains("transcript input"))
+                    .unwrap();
+                assert_eq!(
+                    composer.cursor_pos_with_options(area, options),
+                    Some((5, row as u16))
+                );
+            }
+        }
+    }
+}
