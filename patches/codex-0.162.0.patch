+#[tokio::test]
+async fn cxstatusline_rate_limit_completion_releases_next_minute_tick() {
+    let (mut chat, mut rx, _op_rx) = make_chatwidget_manual(/*model_override*/ None).await;
+    chat.cxstatusline_command = Some(vec!["renderer".to_string()]);
+    set_chatgpt_auth(&mut chat);
+    let now = Instant::now();
+
+    chat.cxstatusline_rate_limit_tick(now);
+    assert!(matches!(
+        rx.try_recv(),
+        Ok(AppEvent::RefreshRateLimits {
+            origin: RateLimitRefreshOrigin::CxStatusLine,
+        })
+    ));
+    assert!(chat.cxstatusline_rate_limit_pending);
+
+    chat.cxstatusline_rate_limit_tick(now + Duration::from_secs(/*secs*/ 59));
+    assert!(matches!(
+        rx.try_recv(),
+        Err(tokio::sync::mpsc::error::TryRecvError::Empty)
+    ));
+
+    chat.finish_cxstatusline_rate_limit_refresh();
+    assert!(!chat.cxstatusline_rate_limit_pending);
+    chat.cxstatusline_rate_limit_tick(now + Duration::from_secs(/*secs*/ 59));
+    assert!(matches!(
+        rx.try_recv(),
+        Err(tokio::sync::mpsc::error::TryRecvError::Empty)
+    ));
+
+    chat.cxstatusline_rate_limit_tick(now + Duration::from_secs(/*secs*/ 60));
+    assert!(matches!(
+        rx.try_recv(),
+        Ok(AppEvent::RefreshRateLimits {
+            origin: RateLimitRefreshOrigin::CxStatusLine,
+        })
+    ));
+}
