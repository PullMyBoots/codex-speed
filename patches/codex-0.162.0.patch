+impl crate::workspace_command::WorkspaceCommandExecutor for CxLocalGitRunner {
+    fn run(
+        &self,
+        command: crate::workspace_command::WorkspaceCommand,
+    ) -> std::pin::Pin<
+        Box<
+            dyn std::future::Future<
+                    Output = Result<
+                        crate::workspace_command::WorkspaceCommandOutput,
+                        crate::workspace_command::WorkspaceCommandError,
+                    >,
+                > + Send
+                + '_,
+        >,
+    > {
+        Box::pin(async move {
+            // Only local Git runs: PR probes must never contact the owner's GitHub account.
+            if command.argv.first().map(String::as_str) != Some("git") {
+                return Ok(crate::workspace_command::WorkspaceCommandOutput {
+                    exit_code: 1,
+                    stdout: String::new(),
+                    stderr: String::new(),
+                });
+            }
+            let mut process = tokio::process::Command::new("git");
+            process.args(&command.argv[1..]).kill_on_drop(true);
+            if let Some(cwd) = command.cwd {
+                process.current_dir(cwd);
+            }
+            for (key, value) in command.env {
+                if let Some(value) = value {
+                    process.env(key, value);
+                } else {
+                    process.env_remove(key);
+                }
+            }
+            let output = tokio::time::timeout(command.timeout, process.output())
+                .await
+                .expect("git timeout")
+                .expect("git runs");
+            Ok(crate::workspace_command::WorkspaceCommandOutput {
+                exit_code: output.status.code().unwrap_or(1),
+                stdout: String::from_utf8_lossy(&output.stdout).into_owned(),
+                stderr: String::from_utf8_lossy(&output.stderr).into_owned(),
+            })
+        })
+    }
