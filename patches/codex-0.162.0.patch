+    *chat.cxstatusline_output.lock().unwrap() = Some(vec![Line::from("Out: ~42 t/s")]);
+    chat.cxstatusline_fresh.store(true, Ordering::Release);
+    chat.cxstatusline_pre_draw_tick();
+    chat.refresh_status_line();
+    assert_eq!(
+        chat.bottom_pane.status_line_text().as_deref(),
+        Some(native.as_str())
+    );
+    for width in [40, 83, 120] {
+        let height = chat.desired_height(width);
+        let mut terminal = Terminal::new(TestBackend::new(width, height)).unwrap();
+        terminal
+            .draw(|frame| chat.render(frame.area(), frame.buffer_mut()))
+            .unwrap();
+        let screen = normalized_backend_snapshot(terminal.backend());
+        assert!(
+            screen.contains("Out: ~42 t/s"),
+            "plugin row at width {width}"
+        );
+    }
+}
