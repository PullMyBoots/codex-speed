+/// Client-observed throughput; rates are estimates, never hardware-side timings.
+#[derive(Debug, Clone, PartialEq, Deserialize, Serialize, TS, JsonSchema)]
+pub struct ModelStreamMetrics {
+    pub phase: String,
+    #[serde(default)]
+    pub stream_kind: String,
